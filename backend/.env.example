# ---------------------------------------------------------------------------
# Local development. On Render set the same keys as environment variables,
# but omit PORT — the platform provides it.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# Public origin of this service. No trailing slash.
BASE_URL=http://skillforge.localhost:3002

# Neon connection string used by the running server.
# POOLED endpoint — the hostname contains "-pooler".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Same database, DIRECT endpoint — the same hostname with "-pooler" removed.
# Used only by the Prisma CLI (migrate / db push): the pooler runs PgBouncer in
# transaction mode, which cannot hold the session-level advisory lock Prisma
# Migrate takes, so migrations can hang there instead of failing loudly.
DIRECT_URL=postgresql://user:password@ep-xxx.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Auth0 tenant domain, with scheme and no trailing slash.
OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com

# Auth0 -> Applications -> SkillForge -> Settings
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Auth0 -> Applications -> APIs -> Identifier. Identical in every service.
API_AUDIENCE=https://skillbridge-api

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The other team's application — used only for a link in the interface.
PEER_APP_URL=http://careeros.localhost:3000

# ---------------------------------------------------------------------------
# AI provider. Groq speaks the OpenAI wire format, so switching provider is a
# change of URL: another hosted service, or a local Ollama at
# http://localhost:11434/v1 (where the key can be any non-empty string).
# ---------------------------------------------------------------------------
AI_BASE_URL=https://api.groq.com/openai/v1

# console.groq.com -> API Keys. Free tier, no card required.
AI_API_KEY=

# openai/gpt-oss-120b — larger daily budget
# llama-3.3-70b-versatile — faster
AI_MODEL=openai/gpt-oss-120b
